    "@stylistic/eslint-plugin": "4.2.0",
    "@types/eslint": "9.6.1",
    "@types/eslint__eslintrc": "3.3.0",
    "@types/eslint__js": "9.14.0",
    "@types/postcss-js": "4.0.4",
    "cross-env": "7.0.3",
    "eslint": "9.26.0",
    "eslint-config-prettier": "10.1.5",
