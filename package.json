    "@pinia/nuxt": "0.11.0",
    "@vueuse/core": "13.1.0",
    "@vueuse/nuxt": "13.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "nuxt": "3.17.2",
    "pinia": "3.0.2",
    "pinia-plugin-persistedstate": "4.2.0",
    "radix-vue": "1.9.17",
    "tailwind-merge": "3.2.0",
    "tailwindcss-animate": "1.0.7",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
