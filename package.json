  "license": "BSD-3-Clause",
  "readme": "README.md",
  "scripts": {
    "build": "cross-env NODE_ENV=production NITRO_PRESET=bun nuxt build",
    "dev": "nuxt dev --port 5561 --host 127.0.0.1",
